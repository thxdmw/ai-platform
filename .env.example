# 生产部署复制为 /app/ai-platform/.env；真实密钥不得提交到仓库。
SERVER_PORT=20005
AI_CHAT_PROVIDER=deepseek
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
DEEPSEEK_API_KEY=请填写DeepSeek密钥
DEEPSEEK_CHAT_MODEL=deepseek-chat
WEBSITE_ASSISTANT_ALLOWED_ORIGINS=https://thxdxw.cn
WEBSITE_ASSISTANT_REQUESTS_PER_MINUTE=20
WEBSITE_ASSISTANT_SSE_TIMEOUT=90s

# 博客助手页面访问口令及博客系统 Agent API 配置。
BLOG_ASSISTANT_ACCESS_TOKEN=请填写高强度随机访问口令
BLOG_API_BASE_URL=https://cms.thxdxw.cn/agent/api/blog
BLOG_API_KEY=请填写博客Agent接口密钥
BLOG_API_CONNECT_TIMEOUT=5s
BLOG_API_REQUEST_TIMEOUT=30s
BLOG_ASSISTANT_SSE_TIMEOUT=120s
BLOG_PUBLICATION_APPROVAL_TTL=15m

# 服务器助手。每台服务器独立选择“用户名+私钥”或“用户名+密码”；密码只通过 passwordEnv 引用。
# 把私钥和 known_hosts 放到宿主机 /app/ai-platform/ssh，容器内统一从 /run/ai-platform/ssh 只读访问。
SERVER_ASSISTANT_ACCESS_TOKEN=请填写高强度随机访问口令
SERVER_ASSISTANT_SSH_DIR=/app/ai-platform/ssh
SERVER_ASSISTANT_SERVERS_JSON=[{"id":"server-a","name":"服务器 A","host":"server-a.example.com","port":22,"username":"ops","privateKeyPath":"/run/ai-platform/ssh/server_a_key","knownHostsPath":"/run/ai-platform/ssh/known_hosts","allowedServices":["nginx","docker"],"allowedContainers":["app-a"]},{"id":"server-b","name":"服务器 B","host":"server-b.example.com","port":22,"username":"admin","passwordEnv":"SERVER_B_SSH_PASSWORD","knownHostsPath":"/run/ai-platform/ssh/known_hosts","allowedServices":["nginx"],"allowedContainers":["app-b"]}]
SERVER_B_SSH_PASSWORD=请填写服务器B的SSH密码
SERVER_SSH_CONNECT_TIMEOUT=8s
SERVER_SSH_COMMAND_TIMEOUT=30s
SERVER_ASSISTANT_SSE_TIMEOUT=120s
SERVER_OPERATION_APPROVAL_TTL=10m
SERVER_SSH_MAX_OUTPUT_BYTES=16384

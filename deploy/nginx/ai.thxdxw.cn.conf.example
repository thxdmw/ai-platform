server {
    listen 80;
    listen [::]:80;
    server_name ai.thxdxw.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ai.thxdxw.cn;

    ssl_certificate /etc/letsencrypt/live/ai.thxdxw.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.thxdxw.cn/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:20005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE 需要关闭代理缓冲，否则模型片段可能积累后一次性返回。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    location /widgets/ {
        proxy_pass http://127.0.0.1:20005;
        proxy_set_header Host $host;
        expires 10m;
        add_header Cache-Control "public, max-age=600";
    }
}
